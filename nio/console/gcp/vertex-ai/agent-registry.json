{
  "displayName": "Nexus Agent Registry",
  "description": "Google Cloud Agent Engine configuration for Nexus Console",
  "version": "1.0.0",
  "agents": [
    {
      "agentId": "orchestrator",
      "displayName": "Atlas - Supervisor Orchestrator",
      "description": "Coordinates all agent workflows and manages state transitions",
      "model": {
        "modelId": "gemini-2.5-pro",
        "location": "europe-west3",
        "contextWindow": "1M tokens"
      },
      "runtime": {
        "engine": "Vertex AI Agent Engine",
        "serviceAccount": "atlas-orchestrator@PROJECT_ID.iam.gserviceaccount.com",
        "vpcConfig": {
          "network": "nexus-vpc",
          "subnetwork": "nexus-subnet"
        }
      },
      "tools": [
        "Cloud Workflows API",
        "Vertex AI Agent Engine",
        "Pub/Sub API",
        "Vertex AI Vector Search"
      ],
      "allowedGoogleCloudServices": [
        "workflows.googleapis.com",
        "aiplatform.googleapis.com",
        "pubsub.googleapis.com"
      ]
    },
    {
      "agentId": "cartographer",
      "displayName": "Maple - Repository Cartographer",
      "description": "Maps repository structure and dependencies",
      "model": {
        "modelId": "gemini-2.5-flash",
        "location": "europe-west3",
        "contextWindow": "256K tokens"
      },
      "runtime": {
        "engine": "Vertex AI Agent Engine",
        "serviceAccount": "maple-cartographer@PROJECT_ID.iam.gserviceaccount.com"
      },
      "tools": [
        "Developer Connect API",
