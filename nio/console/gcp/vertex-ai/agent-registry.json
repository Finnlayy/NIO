  "workflow": {
    "engine": "Cloud Workflows",
    "states": [
      "PLANNING",
      "EXECUTING",
      "REVIEWING",
      "EVALUATING",
      "REVISING",
      "DEPLOYING",
      "ESCALATED"
    ],
    "gates": {
      "deployThreshold": 85,
      "maxAutonomousRevisions": 2,
      "humanApprovalRequired": true
    }
  },
  "security": {
    "vpcServiceControls": true,
    "privateServiceConnect": true,
    "secretManager": true,
    "iamConditions": true
  }
}
