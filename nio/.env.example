# NIO Platform — local development

# NIO middleware API (backend)
NIO_API_URL=http://localhost:4000
PORT=4000
MODEL_MANIFEST_PATH=../twin/model-manifest.json

# Next.js console
DATABASE_URL=postgresql://nio_user:nio_dev_password@localhost:5432/nio_db

# Model providers (referenced by twin/model-manifest.json)
LMSTUDIO_ENABLED=1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=google/gemma-4-e2b
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MAX_TOKENS=512
MOONSHOT_API_KEY=
XAI_API_KEY=

# BytePlus ModelArk (OpenAI-compatible; keys start with ark-)
BYTEPLUS_ARK_API_KEY=
BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# BYTEPLUS_ARK_MODEL=your-endpoint-or-model-id
OPENROUTER_API_KEY=
OPENROUTER_REFERER=https://github.com/finnp/General
OPENROUTER_APP_TITLE=NIO Platform
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional GCP / Genkit
PROJECT_ID=
VERTEX_AI_LOCATION=europe-west3
