# =============================================================================
# NIO Neural Orchestrator — Cloud Run / local env
# =============================================================================

# Google Cloud
PROJECT_ID=your-gcp-project-id
REGION=europe-west3
ENVIRONMENT=dev
SERVICE_NAME=nio-orchestrator-dev

# Runtime
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
CORE_ADAPTER_MODE=live
MODEL_MANIFEST_PATH=../twin/model-manifest.json

# LLM providers (local dev — use Secret Manager in Cloud Run)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=

# Optional provider overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://github.com/finnp/General
OPENROUTER_APP_TITLE=NIO Platform
XAI_MODEL=grok-3-mini
MOONSHOT_MODEL=moonshot-v1-8k
