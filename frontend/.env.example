# Copy to .env.local and fill in your tvremix API key (https://tvremix.xyz/account#api-keys)
# Server-only variables — do NOT prefix with NEXT_PUBLIC_, they must never reach the browser.
TVREMIX_MCP_URL="https://tvremix.xyz/api/mcp/v1"
TVREMIX_API_KEY="tvr_your_key_here"

# /telegram: Server-Proxy zur Hermes-API. Das Token erreicht nie den Browser.
NIO_KANBAN_API_URL="http://127.0.0.1:8740"
NIO_KANBAN_API_TOKEN=""
# Optional: weitere erlaubte Hostnamen fuer /telegram, kommagetrennt. Standard ist nur Loopback.
NIO_TELEGRAM_UI_HOSTS=""

# Apollo live: OpenAI-kompatibler Endpoint und Modell-ID des Anbieters.
# Ohne Endpoint antwortet Apollo simuliert und kennzeichnet das mit SIM.
NEXT_PUBLIC_APOLLO_ENDPOINT_URL=
APOLLO_MODEL=

# Speech input for the Apollo terminal, see docs/SPEECH.md. All three are optional.
# STT_ENDPOINT_URL="http://127.0.0.1:8011/v1/audio/transcriptions"
# STT_MODEL="Systran/faster-whisper-small"
# STT_LANGUAGE="de"
