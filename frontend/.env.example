# Marktdaten: offizieller TradingView-MCP. Kein API-Key -- Anmeldung per OAuth:
#   http://localhost:4001/api/market/oauth/start  (im eigenen Browser oeffnen)
# Tokens landen in frontend/.tradingview-oauth.json (gitignoriert, Modus 0600).
# Server-only variables -- do NOT prefix with NEXT_PUBLIC_, they must never reach the browser.
# TRADINGVIEW_MCP_URL="https://mcp.tradingview.com/mcp"
# TRADINGVIEW_OAUTH_STORE="/abs/path/.tradingview-oauth.json"

# Optional exact host (including port, if any) for a trusted remote preview.
# No scheme or path. Unset keeps API access loopback-only.
# NIO_PREVIEW_HOST="4001-your-sandbox.e2b.app"

# Shared server-only secret source for Apollo and the Python agent dispatcher.
# Owner-only JSON mount (0600), never put the file in Git. Environment wins.
# NIO_SECRET_FILE="/absolute/path/to/secret-mount.json"
# NIO_REPO_ROOT="/absolute/path/to/NIO"
# NIO_LLM_PROVIDER="groq"
# Explicit worker permission; only the selected key is injected.
# NIO_KANBAN_SECRET_ALLOWLIST="GROQ_API_KEY"
# Provider/model names: orchestrator/provider_catalog.json.
# No endpoint selects the server provider. Failure NEVER falls back to simulation.
# NEXT_PUBLIC_APOLLO_ENDPOINT_URL is legacy and must never contain a secret.
NEXT_PUBLIC_APOLLO_ENDPOINT_URL=
APOLLO_MODEL=

# Speech input for the Apollo terminal, see docs/SPEECH.md. All three are optional.
# STT_ENDPOINT_URL="http://127.0.0.1:8011/v1/audio/transcriptions"
# STT_MODEL="Systran/faster-whisper-small"
# STT_LANGUAGE="de"
