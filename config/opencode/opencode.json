{
  "$schema": "https://opencode.ai/config.json",
  "model": "groq/gpt-oss-120b",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (lokal, ueber model-relay)",
      "options": {
        "baseURL": "http://nio-model-relay:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:latest": {
          "name": "qwen2.5-coder (Base, ohne native Tool-Calls)"
        },
        "llama3.1:8b": {
          "name": "llama3.1:8b (Tool-Calls unzuverlaessig)",
          "tool_call": true
        },
        "qwen2.5:7b-instruct": {
          "name": "qwen2.5:7b-instruct",
          "tool_call": true
        },
        "qwen2.5:7b-ctx16k": {
          "name": "qwen2.5:7b-instruct (num_ctx 16384)",
          "tool_call": true
        }
      }
    },
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Groq (Cloud, schnelle Tool-Calls)",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B (Tool-Calls, 128k ctx)",
          "tool_call": true
        },
        "gpt-oss-20b": {
          "name": "GPT-OSS 20B (schnell, Tool-Calls, 128k ctx)",
          "tool_call": true
        }
      }
    },
    "freellmapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "freellmapi (ueber model-relay)",
      "options": {
        "baseURL": "http://nio-model-relay:3001/v1",
        "apiKey": "{env:FREELLMAPI_KEY}"
      },
      "models": {
        "auto": {
          "name": "FreeLLMAPI auto-route (bester freier Anbieter)",
          "tool_call": true
        },
        "qwen3.8-max": {
          "name": "Qwen3.8-Max via FreeLLMAPI",
          "tool_call": true
        },
        "gemini-flash": {
          "name": "Gemini Flash via FreeLLMAPI",
          "tool_call": true
        }
      }
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      "runtime/**": "deny",
      ".git/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "runtime/**": "deny"
    },
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push*": "deny",
      "git remote*": "deny",
      "git config*": "deny",
      "ls*": "allow",
      "python3 -m pytest*": "allow",
      "python3 -m unittest*": "allow"
    },
    "webfetch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "mcp": {
    "vault": {
      "type": "local",
      "command": [
        "python3",
        "/nio/mcp/scripts/vault_mcp.py"
      ],
      "enabled": true
    }
  }
}
