{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nio-api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dist/server.js"],
      "env": { "HOST": "127.0.0.1", "PORT": "4000" },
      "port": 4000
    },
    {
      "name": "nio-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 4001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 4001
    },
    {
      "name": "orchestrator",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 4000
    }
  ]
}
