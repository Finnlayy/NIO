{
  "name": "neural-orchestrator",
  "version": "1.0.0",
  "description": "Modulare Injektions- und Middleware-Schicht für den Neural Intelligence Network Core.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "neu:check": "make check",
    "neu:e2e": "python3 scripts/ci_e2e_unlimited.py",
    "neu:jobs": "python3 -m orchestrator job list",
    "neu:lint": "python3 -m ruff check .",
    "neu:reclaim": "python3 -m orchestrator job reclaim",
    "neu:schedule": "python3 -m orchestrator schedule list",
    "neu:spec": "python3 -m orchestrator spec",
    "neu:status": "python3 -m orchestrator status",
    "neu:test": "python3 -m unittest discover -s tests -t . -v",
    "neu:types": "python3 -m mypy",
    "neu:validate": "python3 -m orchestrator validate --schema",
    "neu:watch": "python3 -m orchestrator watch",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "test": "pytest evals/tests",
    "trace:generate": "ts-node --project tsconfig.evals.json evals/tests/run_trace.ts",
    "tunnel": "ngrok http 4000",
    "typecheck": "tsc --noEmit",
    "ui:build": "npm --prefix frontend run build",
    "ui:dev": "npm --prefix frontend run dev",
    "ui:start": "npm --prefix frontend run start"
  },
  "keywords": [
    "orchestrator",
    "prompt-engineering",
    "middleware",
    "typescript"
  ],
  "author": "Neural Architecture Team",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
