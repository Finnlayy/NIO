# Vorlage fuer ~/.config/nio/kanban.env (Rechte 600, liegt nie im Repo).
# Nur nio-kanban.service liest diese Datei. deploy/write_env.sh erzeugt sie und
# fuellt die Geheimnisse selbst.

# Geheimnisse. Limbs und Worker bekommen keines davon, Apollo auch nicht.
NIO_KANBAN_API_TOKEN=
NIO_APPROVAL_KEY=
# Eingeschraenktes Token, das Apollo benutzt (nur UI-Routen). Wird nach apollo.env gespiegelt.
NIO_KANBAN_APOLLO_TOKEN=

# Pfade
NEU_ROOT=
NIO_REPO_ROOT=
NIO_PYTHON=
NIO_OBSIDIAN_VAULT=

# Kanban-Sandbox: Image ohne Setuid, weil Snap-Docker no-new-privileges nicht vertraegt.
NIO_KANBAN_SANDBOX=docker
NIO_KANBAN_IMAGE=nio-worker:1
NIO_KANBAN_DOCKER_NO_NEW_PRIVILEGES=0

# Modell fuer OpenManus. Nur der Key des lokalen Gateways, nie ein Provider-Key.
FREELLMAPI_KEY=
OPENMANUS_MODEL=
