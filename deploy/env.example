# Vorlage fuer ~/.config/nio/nio.env (Rechte 600, liegt nie im Repo).
# deploy/install.sh erzeugt die Datei und fuellt die Geheimnisse selbst.

# Geheimnisse. Limbs und Worker bekommen keines davon.
NIO_KANBAN_API_TOKEN=
NIO_APPROVAL_KEY=
NIO_APOLLO_APPROVAL_PIN=

# Pfade
NEU_ROOT=
NIO_REPO_ROOT=
NIO_PYTHON=
NIO_OBSIDIAN_VAULT=

# Kanban-Sandbox: Image ohne Setuid, weil Snap-Docker no-new-privileges nicht vertraegt.
NIO_KANBAN_SANDBOX=docker
NIO_KANBAN_IMAGE=nio-worker:1
NIO_KANBAN_DOCKER_NO_NEW_PRIVILEGES=0

# Modell fuer OpenManus. Nur der Key des lokalen Gateways, nie ein Provider-Key.
FREELLMAPI_KEY=
OPENMANUS_MODEL=
