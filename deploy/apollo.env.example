# Vorlage fuer ~/.config/nio/apollo.env (Rechte 600, liegt nie im Repo).
# Nur nio-apollo.service liest diese Datei. Sie enthaelt bewusst weder
# NIO_KANBAN_API_TOKEN noch NIO_APPROVAL_KEY: Die bleiben in kanban.env.
# deploy/write_env.sh erzeugt sie und haelt das Apollo-Token synchron.

# Eingeschraenktes Kanban-Token (Boards, Tasks, Worker anlegen, Stop, Freigabe per PIN).
NIO_KANBAN_APOLLO_TOKEN=
# PIN fuer Freigaben in Apollo. Apollo prueft sie selbst; das Backend sieht sie nie.
NIO_APOLLO_APPROVAL_PIN=

# Pfade (Vault-Suche und Telemetrie starten Python aus dem Checkout)
NIO_REPO_ROOT=
NIO_PYTHON=
NIO_OBSIDIAN_VAULT=

# Chat ueber das lokale Gateway
FREELLMAPI_KEY=

# Optional, ohne sie zeigen die Widgets SIM bzw. Sprache ist aus:
# TVREMIX_API_KEY=
# STT_ENDPOINT_URL=
