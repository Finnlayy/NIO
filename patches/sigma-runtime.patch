@@ -0,0 +1,79 @@
+"""Synchrones, einmalig verwendbares Operator-Freigabeticket fuer Sigma."""
+from __future__ import annotations
+
+import hashlib
+import json
+import threading
+import time
+import uuid
+from typing import Any, Literal
+
+from pydantic import BaseModel, Field
+
+
+def _hash(arguments: dict[str, Any]) -> str:
+    args = {key: value for key, value in arguments.items() if key != "approval_ticket_id"}
+    return hashlib.sha256(json.dumps(args, sort_keys=True, default=str).encode()).hexdigest()
+
+
+class ApprovalTicket(BaseModel):
+    ticket_id: str = Field(default_factory=lambda: uuid.uuid4().hex)
+    tool_name: str
+    arguments: dict[str, Any]
+    arguments_sha256: str
+    status: Literal["PENDING", "APPROVED", "REJECTED", "EXPIRED", "CONSUMED"] = "PENDING"
+    created_at_ms: int
+    expires_at_ms: int
+    operator_id: str = ""
+    decision_reason: str = ""
+
+
+class ApprovalGate:
+    """Schuetzt Ticket-Status und Verbrauch gegen parallele Aufrufe."""
+
+    def __init__(self, ttl_s: float = 300) -> None:
+        self.ttl_s = ttl_s
+        self._lock = threading.Lock()
+        self._tickets: dict[str, ApprovalTicket] = {}
+
+    def _expire(self, ticket: ApprovalTicket) -> None:
+        if ticket.status in ("PENDING", "APPROVED") and time.time() * 1000 >= ticket.expires_at_ms:
+            ticket.status = "EXPIRED"
+
+    def require(self, tool_name: str, arguments: dict[str, Any]) -> ApprovalTicket:
+        now = int(time.time() * 1000)
+        args = {key: value for key, value in arguments.items() if key != "approval_ticket_id"}
+        ticket = ApprovalTicket(tool_name=tool_name, arguments=args, arguments_sha256=_hash(args),
+                                created_at_ms=now, expires_at_ms=now + int(self.ttl_s * 1000))
+        with self._lock:
+            self._tickets[ticket.ticket_id] = ticket.model_copy(deep=True)
+        return ticket.model_copy(deep=True)
+
+    def resolve(self, ticket_id: str, approved: bool, operator_id: str, reason: str = "") -> ApprovalTicket:
+        with self._lock:
+            ticket = self._tickets.get(ticket_id)
+            if ticket is None:
+                raise KeyError(ticket_id)
+            self._expire(ticket)
+            if ticket.status != "PENDING":
+                raise ValueError("Ticket ist nicht mehr offen")
+            ticket.status = "APPROVED" if approved else "REJECTED"
+            ticket.operator_id, ticket.decision_reason = operator_id, reason
+            return ticket.model_copy(deep=True)
+
+    def consume(self, ticket_id: str, tool_name: str, arguments: dict[str, Any]) -> bool:
+        with self._lock:
+            ticket = self._tickets.get(ticket_id)
+            if ticket is None:
+                return False
+            self._expire(ticket)
+            if ticket.status != "APPROVED" or ticket.tool_name != tool_name or ticket.arguments_sha256 != _hash(arguments):
+                return False
+            ticket.status = "CONSUMED"
+            return True
+
+    def pending(self) -> list[ApprovalTicket]:
+        with self._lock:
+            for ticket in self._tickets.values():
+                self._expire(ticket)
+            return [ticket.model_copy(deep=True) for ticket in self._tickets.values() if ticket.status == "PENDING"]
