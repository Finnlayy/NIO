new file mode 100644
index 0000000..18c9906
--- /dev/null
+++ b/tests/test_approval_gate.py
@@ -0,0 +1,47 @@
+"""Sicherheitsvertraege fuer das synchrone Sigma-Freigabegate."""
+import time
+
+from fastapi.testclient import TestClient
+
+from app.llm.approval_gate import ApprovalGate
+from app.llm.tool_executor import LlmToolExecutor, set_tool_executor
+from app.server.main import app
+
+
+def test_approval_one_use_and_argument_binding():
+    executor = LlmToolExecutor()
+    args = {"max_daily_loss_usd": 100}
+    first = executor.call("update_risk_settings", **args)
+    assert first.status == "APPROVAL_REQUIRED" and not executor.risk_overrides
+    ticket = first.result_data["ticket_id"]
+    assert executor.call("update_risk_settings", **args, approval_ticket_id=ticket).status == "APPROVAL_REQUIRED"
+    executor.approval_gate.resolve(ticket, True, "operator", "geprueft")
+    assert executor.call("update_risk_settings", max_daily_loss_usd=200, approval_ticket_id=ticket).status == "APPROVAL_REQUIRED"
+    assert executor.call("update_risk_settings", **args, approval_ticket_id=ticket).status == "SUCCESS"
+    assert executor.call("update_risk_settings", **args, approval_ticket_id=ticket).status == "APPROVAL_REQUIRED"
+
+
+def test_expiry_and_copies():
+    gate = ApprovalGate(ttl_s=0.01)
+    ticket = gate.require("x", {"value": [1]})
+    ticket.arguments["value"].append(2)
+    assert gate.pending()[0].arguments == {"value": [1]}
+    time.sleep(0.02)
+    assert not gate.consume(ticket.ticket_id, "x", {"value": [1]})
+    assert not gate.pending()
+
+
+def test_operator_routes_fail_closed(monkeypatch):
+    executor = LlmToolExecutor()
+    set_tool_executor(executor)
+    client = TestClient(app)
+    monkeypatch.delenv("SIGMA_OPERATOR_TOKEN", raising=False)
+    assert client.get("/api/v1/approvals").status_code == 503
+    monkeypatch.setenv("SIGMA_OPERATOR_TOKEN", "secret")
+    assert client.get("/api/v1/approvals").status_code == 401
+    assert client.post("/api/v1/safety/release").status_code == 401
+    ticket = executor.call("update_risk_settings", max_daily_loss_usd=100).result_data["ticket_id"]
+    headers = {"Authorization": "Bearer secret"}
+    assert client.post(f"/api/v1/approvals/{ticket}/resolve", headers=headers, json={"approved": True}).status_code == 200
+    assert executor.call("update_risk_settings", max_daily_loss_usd=100, approval_ticket_id=ticket).status == "SUCCESS"
+    set_tool_executor(None)
